PORT=5000

# Where raw uploads land before processing
UPLOAD_DIR=uploads

# Where generated HLS renditions + playlists are written (one subfolder per video)
HLS_OUTPUT_DIR=storage/hls

# SQLite database file (holds video + job records, survives restarts)
DB_FILE=database/app.db

# How many videos can transcode at the same time
WORKER_CONCURRENCY=2

# Failed jobs are retried this many times before being marked FAILED
MAX_RETRIES=3

# Base delay (ms) before a retry; actual delay grows with each attempt
# (attempt 1 -> RETRY_BASE_DELAY_MS, attempt 2 -> RETRY_BASE_DELAY_MS * 2, ...)
RETRY_BASE_DELAY_MS=5000

# Path to the ffmpeg binary. "ffmpeg" works if it's on PATH.
FFMPEG_PATH=ffmpeg
