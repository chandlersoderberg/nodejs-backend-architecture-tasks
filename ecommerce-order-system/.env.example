# Server
PORT=3000

# Workers
WORKER_COUNT=4

# Retry
MAX_RETRIES=3
RETRY_DELAY=1000

# Job execution
JOB_TIMEOUT=30000

# Scheduler (ms between "is it time to run the daily task yet" checks are
# NOT used - we calculate the next midnight and setTimeout to it directly.
# This var is kept only for any secondary periodic checks we may add later,
# e.g. a housekeeping sweep).
SCHEDULER_INTERVAL=60000

# Persistence
DATA_DIR=./data
